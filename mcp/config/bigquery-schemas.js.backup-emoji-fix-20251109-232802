/**
 * Get active schema configuration from environment
 * @returns {Object} Active schema config
 */
function getActiveSchema() {
  const schemaName = process.env.BIGQUERY_CLIENT_SCHEMA || 'default';

  if (!BIGQUERY_SCHEMAS[schemaName]) {
    console.warn(`⚠️ Schema "${schemaName}" not found. Falling back to "default".`);
    return BIGQUERY_SCHEMAS['default'];
  }

  console.log(`📊 Active BigQuery Schema: ${schemaName}`);
  return BIGQUERY_SCHEMAS[schemaName];
}

/**
 * List all available schemas
 * @returns {Array<string>} Schema names
 */
function listSchemas() {
  return Object.keys(BIGQUERY_SCHEMAS);
}

/**
 * Get schema by name
 * @param {string} name - Schema name
 * @returns {Object|null} Schema config or null
 */
function getSchema(name) {
  return BIGQUERY_SCHEMAS[name] || null;
}

